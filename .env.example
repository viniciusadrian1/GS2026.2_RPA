# Copie para .env (que NÃO vai para o Git). Todas as chaves são opcionais.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORTAL_URL=http://127.0.0.1:8000
USE_PLAYWRIGHT=1
ENABLE_ASR=0
CONFIDENCE_THRESHOLD=0.55
RETRY_BASE_DELAY=1.0

# Ver o navegador do robô trabalhando (útil para testar e gravar o vídeo):
PLAYWRIGHT_HEADLESS=1
PLAYWRIGHT_SLOW_MO_MS=0
